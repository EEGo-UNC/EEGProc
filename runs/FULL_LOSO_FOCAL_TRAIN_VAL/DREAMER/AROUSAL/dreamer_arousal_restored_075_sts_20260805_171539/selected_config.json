{
  "epochs": 100,
  "batch_size": 64,
  "optimizer": "adamw",
  "classification_learning_rate": 3e-05,
  "vae_learning_rate": 2e-05,
  "weight_decay": 5e-05,
  "classification_steps_per_batch": 2,
  "vae_steps_per_batch": 1,
  "use_subject_adversarial": true,
  "subject_adversarial_weight": 0.1,
  "subject_loss_weight": 0.5,
